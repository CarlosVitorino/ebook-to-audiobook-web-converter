# Copy to .env and fill in. Everything is optional for local development.

# Where people reach the site. Used in emailed links and the Google redirect.
BASE_URL=http://localhost:8000
# On the server: BASE_URL=https://narrator.guru
# Signs the session cookie. If empty, one is generated once into data/secret.key.
SECRET_KEY=

# Google sign-in. Create an OAuth client (Web application) in Google Cloud Console and add
# <BASE_URL>/signin/google/callback as an authorized redirect URI. Empty = no Google button.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outgoing mail (sign-in links, "your book is ready"). Any SMTP provider: Resend, Postmark, SES...
# Empty SMTP_HOST = mail is printed to the log and written to data/outbox.log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=narrator.guru <hello@narrator.guru>

# Payments through Creem (creem.io). Empty = Buy buttons log the click and say "payments open soon".
# Test mode: keys from the Developers page with Test Mode on. Live: live keys, live products, live webhook.
# The API (test-api.creem.io or api.creem.io) follows the key: test keys start with creem_test_.
# Webhook: in Creem, add <BASE_URL>/webhooks/creem and copy its signing secret here.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
# One one-time product per pack: 1 book €2.99, 5 books €9.95, 15 books €24.95.
CREEM_PRODUCT_ONE=
CREEM_PRODUCT_FIVE=
CREEM_PRODUCT_FIFTEEN=

# Private /stats page: HTTP Basic auth, any user name, this password. Empty = only on localhost.
STATS_PASSWORD=
# How many times faster than real time narration runs on your server (for "ready in about").
NARRATION_SPEED=5
# Abuse limits (defaults shown): free books per network per 30 days, uploads per network per hour.
# FREE_PER_IP=2
# UPLOADS_PER_HOUR=10

# Shown on /terms, /privacy and /refunds. Until LEGAL_OWNER and LEGAL_LAW are set the pages say "Draft".
LEGAL_OWNER=
LEGAL_CONTACT=hello@narrator.guru
LEGAL_LAW=
LEGAL_EMAIL_PROVIDER=
LEGAL_HOST=Hetzner

# Server only (docker-compose.prod.yml): the domain Caddy gets an HTTPS certificate for.
DOMAIN=narrator.guru
